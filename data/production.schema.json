{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Now Playing Theater feed",
  "type": "object",
  "required": [
    "schemaVersion",
    "productions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "demo": {
      "type": "boolean"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "generatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "productions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "credits",
          "types",
          "image",
          "engagements"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "credits": {
            "type": "string"
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image": {
            "type": "string",
            "format": "uri"
          },
          "engagements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "venue",
                "neighborhood",
                "startDate",
                "status",
                "url",
                "sourceId",
                "sourceUrl"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "venue": {
                  "type": "string"
                },
                "neighborhood": {
                  "type": "string"
                },
                "startDate": {
                  "type": "string",
                  "format": "date"
                },
                "openingDate": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                },
                "closingDate": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                },
                "status": {
                  "enum": [
                    "scheduled",
                    "closed"
                  ]
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "sourceId": {
                  "type": "string"
                },
                "sourceUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "lastSeen": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    }
  }
}
